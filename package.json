{
  "name": "vett-cv",
  "private": true,
  "version": "1.0.0-beta",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm run build:api && vercel dev",
    "build": "tsc -b && vite build",
    "build:api": "tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "check:migrations": "node scripts/validar-migrations.mjs",
    "check:secrets": "node scripts/verificar-segredos.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/node": "^5.10.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "formidable": "^3.5.4",
    "jspdf": "^4.2.1",
    "mammoth": "^1.12.1",
    "pdf-parse": "^1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/formidable": "^3.5.1",
    "@types/node": "^20.11.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.13.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "pgsql-parser": "^18.2.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "@vercel/node": {
      "@vercel/python-analysis": {
        "minimatch": "10.2.6",
        "smol-toml": "1.7.1"
      },
      "path-to-regexp": "6.3.0",
      "undici": "6.28.0"
    },
    "@vercel/static-config": {
      "ajv": "8.20.0"
    },
    "js-yaml": "4.3.1"
  }
}
